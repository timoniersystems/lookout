# syntax=docker/dockerfile:1
# Base image with Trivy binary and pre-downloaded vulnerability database.
# Rebuilt every 6 hours so CI/CD scans skip the slow DB download.
ARG TRIVY_VERSION=0.69.3

FROM aquasecurity/trivy:${TRIVY_VERSION} AS trivy

# Download the vulnerability database at build time
RUN trivy image --download-db-only --db-repository ghcr.io/aquasecurity/trivy-db:2

FROM ubuntu:24.04

COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=trivy /root/.cache/trivy /root/.cache/trivy

ENTRYPOINT ["trivy"]
